APP_NAME=M2M100 Translation Service
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

MODEL_NAME=facebook/m2m100_418M
MODEL_CACHE_DIR=./models
MODEL_DEVICE=auto
MODEL_LOCAL_FILES_ONLY=false
MODEL_MAX_INPUT_TOKENS=512
MODEL_MAX_NEW_TOKENS=512
MODEL_NUM_BEAMS=4

API_MAX_TEXT_CHARACTERS=10000
TRANSLATION_MAX_CONCURRENCY=1

LONG_TEXT_CHUNKING_ENABLED=true
LONG_TEXT_CHUNK_MAX_TOKENS=400
LONG_TEXT_MAX_CHUNKS=64

LANGUAGE_DETECTION_MIN_CONFIDENCE=0.30
LANGUAGE_DETECTION_MIN_RELATIVE_DISTANCE=0.05
LANGUAGE_DETECTION_MIN_ALPHABETIC_CHARACTERS=3
LANGUAGE_DETECTION_MAX_CANDIDATES=3
